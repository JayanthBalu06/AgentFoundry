# LLM providers (optional — leave blank to run in deterministic MOCK mode with no API calls)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-5

# Redis (working memory, Celery broker/backend, checkpoint + rate-limit store)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (long-term memory) — persisted to local disk by default
CHROMA_PERSIST_DIR=./chroma_data

# Demo relational database used by the DB tool
DATABASE_URL=sqlite:///./demo.db

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenTelemetry (leave OTEL_EXPORTER_OTLP_ENDPOINT blank to print spans to console)
OTEL_SERVICE_NAME=agentfoundry
OTEL_EXPORTER_OTLP_ENDPOINT=

# Human-in-the-loop
REVIEW_SCORE_THRESHOLD=0.7
PLAN_CONFIDENCE_THRESHOLD=0.6
MAX_SPECIALIST_RETRIES=2

# Sandbox
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=128
